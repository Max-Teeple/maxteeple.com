{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maxteeple-com",
  "main": "src/index.ts",
  // Keep the compatibility date this site already deploys with.
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // "none" keeps /liveview/groups.html from being redirected onto the
    // /liveview/groups API. Directory URLs such as / and /projects/ are not
    // files, so they fall through to the Worker, which serves index.html.
    // Exact files (CSS, images, the ClubSense demo) stay on the asset server.
    "html_handling": "none",
    "run_worker_first": ["/liveview", "/liveview/*"]
  },
  // No database_id / KV id: wrangler deploy provisions both on the free plan.
  "d1_databases": [
    {
      "binding": "LIVEVIEW_DB",
      "database_name": "liveview",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "LIVEVIEW_MEDIA"
    }
  ],
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.sql"],
      "fallthrough": true
    }
  ]
}
